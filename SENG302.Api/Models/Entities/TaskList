using System.ComponentModel.DataAnnotations;

namespace SENG302Template.Api.Models.Entities;

/** 
    A basic task list with a Name between 3 and 128 characters, 
    and an array of Tasks. The Id is auto-generated by the database.
*/
public class TaskList
{
    [Key]
    public int Id { get; set; }

    [MaxLength(128)]
    public string Name { get; set; } = string.Empty;
    public Task[] Tasks { get; set; } = Array.Empty<Task>();

}
